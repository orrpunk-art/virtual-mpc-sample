# Lab kernel fragment, merged on top of arm64 defconfig.
# Everything is built in: the stock rootfs carries modules for the device kernel only.
CONFIG_LOCALVERSION="-mpclab"

# MPC Sample runs a 128-frame (2.9 ms) audio period and handles panel input in step with
# it; with HZ=250 the stream kept hitting xruns and panel input lagged by seconds.
# The device kernel is PREEMPT_RT (6.12.60-imb-rt), where its I2S DMA interrupt runs as a
# FIFO 50 thread. The lab's period interrupts come from snd-aloop's timer (patch 0002):
# under PREEMPT_RT that callback can only run in ksoftirqd at SCHED_OTHER, and it fired
# 2-5 ms late ~100 times a second. Full preemption without RT lets it run in hard IRQ
# context like a DMA interrupt. The app's SCHED_RR threads behave the same on both.
CONFIG_EXPERT=y
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_MODULES=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Boot: initramfs + dm-verity over the untouched stock rootfs, read-only overlay for the lab layer
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_OVERLAY_FS=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IO_URING=y
CONFIG_FHANDLE=y
CONFIG_CONFIGFS_FS=y

# virtio platform
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# Display: virtio-gpu stands in for the SPI panel (KMS dumb buffers). It must be the
# only KMS device (card0): vkms became card0 in the first boot and took the app's output.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VKMS=n
CONFIG_DRM_FBDEV_EMULATION=y
# no penguins: the initramfs shows the stock splash. fbcon stays, it switches the display
# on (its tty is empty: console=hvc0, cursor off with vt.global_cursor_default=0)
CONFIG_LOGO=n
CONFIG_INPUT_EVDEV=y

# Control surface: serial-midi (snd-serial-generic) bound to the PL011 via serdev
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# ALSA
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_SEQ_DUMMY=y
CONFIG_SND_RAWMIDI=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_ALOOP=y
# snd-virmidi removed: its 4 ports showed up in the app as MIDI devices the hardware does not have
CONFIG_SND_VIRMIDI=n
CONFIG_SND_SERIAL_GENERIC=y
CONFIG_SND_VIRTIO=y

# USB gadget stack as on the device (configfs + libusbgx), attached to dummy_hcd
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_FS=y
# no host-side class drivers: the gadget must not show up as a second USB card inside the VM
CONFIG_SND_USB=n
CONFIG_USB_STORAGE=n

# ALSA xrun diagnostics: /proc/asound/cardN/pcmXp/xrun_debug and the snd_pcm trace events
CONFIG_SND_DEBUG=y
CONFIG_SND_PCM_XRUN_DEBUG=y

# Virtual SD card (device: dw_mmc card at mmcblk1, exFAT/FAT, mounted by edisksd).
# Lab: QEMU sdhci-pci + sd-card; virtio-scsi removable disk as the async-I/O alternative.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y


# Kernel event tracing (sched_switch/wakeup, snd_pcm) for diagnosing audio xruns; ~zero cost when off
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
